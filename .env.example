# SSO Login URL (Microsoft MyApps launcher)
BENEFIT_WEBSITE_URL=https://launcher.myapps.microsoft.com/api/signin/YOUR_APP_ID?tenantId=YOUR_TENANT_ID

# Anthropic Claude API key — OPTIONAL, only needed for batch mode (process-receipts.js)
# Not needed when using Claude Code interactively (it reads receipts natively)
# ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# Set to 'true' to auto-submit claims (default: dry-run validate only)
AUTO_SUBMIT=false
